FROM nexus3.dotin.ir:7070/custome-images/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM nexus3.dotin.ir:7070/custome-images/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
COPY ["NuGet.Config", "."]
RUN dotnet restore "src/3.Endpoints/HostedService/Vehicle.Insurance.Endpoints.HostedService.csproj" --verbosity normal
COPY . .
WORKDIR "/src/src/3.Endpoints/HostedService"
RUN dotnet build -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "Vehicle.Insurance.Endpoints.HostedService.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Vehicle.Insurance.Endpoints.HostedService.dll"]

