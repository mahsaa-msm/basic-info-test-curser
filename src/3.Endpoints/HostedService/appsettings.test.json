{
  "ApplicationName": "DIP",
  "ServiceId": "MasterData",
  "ServiceName": "dip-master-data-hosted-test",
  "ServiceVersion": "1.0.0",

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Zamin": "Verbose"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "IsJson": true,
        "Args": {
          "Path": "Logs/dip-master-data-hosted-test.json",
          "formatter": {
            "type": "Serilog.Formatting.Elasticsearch.ElasticsearchJsonFormatter,Serilog.Formatting.Elasticsearch",
            "formatStackTraceAsArray": true
          },
          "RollingInterval": "Day",
          "BatchPostingLimit": 0,
          "Period": 0,
          "InlineFields": true,
          "BufferFileSizeLimitBytes": 0,
          "BufferLogShippingInterval": 0,
          "BufferRetainedInvalidPayloadsLimitBytes": 0,
          "BufferFileCountLimit": 0,
          "ConnectionTimeout": 0,
          "AutoRegisterTemplate": false
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://10.100.7.201:9200",
          "indexFormat": "dip-master-data-hosted-test-index-{0:yyyy.MM}",
          "restrictedToMinimumLevel": "Verbose",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv6",
          "batchPostingLimit": 50,
          "period": 2,
          "inlineFields": true,
          "bufferFileSizeLimitBytes": 5242880,
          "bufferLogShippingInterval": 5000,
          "bufferRetainedInvalidPayloadsLimitBytes": 5000,
          "bufferFileCountLimit": 31,
          "connectionTimeout": 5,
          "emitEventFailure": "WriteToSelfLog",
          "queueSizeLimit": "100000"
        }
      }
    ]
  },

  "AutoMapper": {
    "AssmblyNamesForLoadProfiles": "Master.Data"
  },

  "DistributedRedisCache": {
    "Configuration": "10.100.8.173:6379",
    "InstanceName": "Cache_Test"
  },

  "JobScheduleOption": {
    "Jobs": [
      {
        "Name": "FetchMultiTenantCountriesFromCoreJob",
        "IsEnabled": true,
        "ScheduleType": "Cron",
        "CronExpression": "0 1 * * *", // هر روز ساعت 01:00
        "StartImmediately": false
      },
      {
        "Name": "FetchMultiTenantProvincesFromCoreJob",
        "IsEnabled": true,
        "ScheduleType": "Cron",
        "CronExpression": "0 1 * * *", // هر روز ساعت 01:00
        "StartImmediately": false
      },
      {
        "Name": "FetchMultiTenantCitiesFromCoreJob",
        "IsEnabled": true,
        "ScheduleType": "Cron",
        "CronExpression": "0 1 * * *", // هر روز ساعت 01:00
        "StartImmediately": false
      },
      {
        "Name": "FetchMultiTenantAgreementObligationsFromCoreJob",
        "IsEnabled": true,
        "ScheduleType": "Cron",
        "CronExpression": "0 1 * * *", // هر روز ساعت 01:00
        "StartImmediately": false
      }
    ]
  }
}
